# Copier ce fichier en .env et renseigner les valeurs (ne jamais committer .env)

# Base MySQL locale lancée avec docker compose (identifiants de développement uniquement)
DATABASE_URL="mysql://root:root@localhost:3306/grande_cinema"

# Secret de signature des jetons JWT : chaîne aléatoire longue, différente en production
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

PORT=3000

# Adresse publique du site (retour après paiement), ex. https://la-grande-cinema.up.railway.app
APP_URL="http://localhost:3000"

# Paiement Stripe en mode test (clés « sk_test_… » et « whsec_… » du tableau de bord Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Clé de signature des QR codes des billets : chaîne aléatoire longue
QR_SECRET=""
CORS_ORIGIN="http://localhost:5173"

# Comptes de démonstration créés par « npm run seed »
SEED_ADMIN_EMAIL="admin@lagrandecinema.test"
SEED_ADMIN_PASSWORD=""
SEED_USER_EMAIL="spectateur@lagrandecinema.test"
SEED_USER_PASSWORD=""
SEED_PROG_EMAIL="programmation@lagrandecinema.test"
SEED_PROG_PASSWORD=""
SEED_CONTROLEUR_EMAIL="controle@lagrandecinema.test"
SEED_CONTROLEUR_PASSWORD=""
SEED_CAISSIER_EMAIL="guichet@lagrandecinema.test"
SEED_CAISSIER_PASSWORD=""
